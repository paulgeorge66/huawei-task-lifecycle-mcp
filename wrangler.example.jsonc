{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huawei-task-lifecycle-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "HUAWEI_PUSH_URL": "https://hiboard-claw-drcn.ai.dbankcloud.cn/distribution/message/cloud/claw/msg/upload",
    "DELIVERY_QUEUE_NAME": "huawei-task-delivery",
    "DEAD_LETTER_QUEUE_NAME": "huawei-task-delivery-dlq",
    "V3_SHADOW_WRITE": "true",
    "V3_DELIVERY": "false",
    "PUBLIC_ORIGIN": "https://example.workers.dev",
    "PUBLIC_REPOSITORY_URL": "https://github.com/OWNER/huawei-task-lifecycle-mcp",
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 },
  },
  "triggers": { "crons": ["* * * * *"] },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "huawei-task-lifecycle-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
  "queues": {
    "producers": [{ "binding": "DELIVERY_QUEUE", "queue": "huawei-task-delivery" }],
    "consumers": [
      {
        "queue": "huawei-task-delivery",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 5,
        "retry_delay": 30,
        "dead_letter_queue": "huawei-task-delivery-dlq",
      },
      {
        "queue": "huawei-task-delivery-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 1,
      },
    ],
  },
}
